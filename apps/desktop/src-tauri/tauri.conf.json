{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GIT STRATA",
  "mainBinaryName": "git-strata-desktop",
  "version": "0.1.0",
  "identifier": "io.github.dickwu.git-strata",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:4001",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GIT STRATA",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "copyright": "Copyright 2026 Peilin Wu",
    "license": "MIT OR Apache-2.0",
    "shortDescription": "Watch and approve git-strata sessions.",
    "publisher": "Peilin Wu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
