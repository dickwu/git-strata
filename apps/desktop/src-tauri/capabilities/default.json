{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC, events, window dragging (overlay titlebar), opener, platform query. No fs, http, dialog or shell (G6). The app commands listed in build.rs APP_COMMANDS, including service and update actions, are granted here only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "os:allow-platform",
    "core:window:allow-start-dragging",
    "allow-daemon-status",
    "allow-daemon-socket",
    "allow-sessions-list",
    "allow-session-status",
    "allow-du",
    "allow-deps-list",
    "allow-deps-approve",
    "allow-legacy-agent",
    "allow-daemon-start",
    "allow-update-state",
    "allow-update-check",
    "allow-update-install",
    "allow-update-cancel",
    "allow-daemon-restart",
    "allow-daemon-move-into-app",
    "allow-daemon-setup",
    "allow-cli-link-install",
    "allow-update-rollback"
  ]
}
