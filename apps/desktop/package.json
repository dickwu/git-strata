{
  "name": "git-strata-desktop",
  "private": true,
  "version": "0.2.1",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "next dev --turbopack -p ${PORT:-4001}",
    "build": "next build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features dev-connector",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "bun test src",
    "check": "bun run typecheck && bun test src"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "antd": "^6.7.0",
    "next": "^16.4.6",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  }
}
